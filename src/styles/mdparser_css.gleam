pub const css = ".cards-container{--folder-card-bg-color:#fff;--folder-card-font-color:#1a1a1a;--folder-card-hover-font-color:#8a1717;--folder-card-hover-color:transparent;--folder-card-click-color:transparent;box-sizing:border-box;width:100%;color:var(--folder-card-font-color);font-family:var(--zFontSerif);margin:1.5em 0;padding:0;font-size:1rem;list-style:none}.cards-container>.card{box-sizing:border-box;background:0 0;border:0;width:100%;margin:0;padding:0 0 0 2em;line-height:1.9;list-style:none;position:relative}.card:before,.card:after{content:\"\";pointer-events:none;position:absolute;left:.5em}.card:before{border-left:1px solid #aaa;top:0;bottom:0}.card:last-child:before{height:.95em;bottom:auto}.card:after{border-top:1px solid #aaa;width:1em;top:.95em}.card-top{justify-content:space-between;align-items:baseline;gap:16px;display:flex}.cards-container .card-header{min-width:0;color:var(--folder-card-hover-font-color);overflow-wrap:anywhere;flex:auto;align-items:baseline;gap:.5em;font-weight:400;text-decoration:none;display:flex}.cards-container .card-header:hover .card-name{text-underline-offset:.2em;text-decoration:underline}.card-header>span{max-width:100%}.card-icon{text-align:center;flex:0 0 1.25em}.card-header svg{flex-shrink:0}.card-name{overflow-wrap:anywhere;min-width:0;margin:0}.card-time{white-space:nowrap;color:#777;flex-shrink:0;font-size:.8rem}.code-block-wrapper{position:relative}.code-block-wrapper>code{padding:1em;display:block}.copy-btn{cursor:pointer;background:#ddd0;border:none;border-radius:4px;padding:4px;font-size:14px;transition:background .2s;display:none;position:absolute;top:6px;right:6px}.code-block-wrapper:hover>.copy-btn{display:inline-block}.copy-btn:hover{background:#ddd6}"
