pub const css = ".cards-container{--folder-card-bg-color:#fff;--folder-card-font-color:#1a1a1a;--folder-card-hover-font-color:#8a1717;--folder-card-hover-color:transparent;--folder-card-click-color:transparent;box-sizing:border-box;width:100%;color:var(--folder-card-font-color);font-family:var(--zFontSerif);margin:1.5em 0;padding:0;font-size:1rem;list-style:none}.cards-container>.card{box-sizing:border-box;background:0 0;border:0;width:100%;margin:0;padding:0 0 0 2em;line-height:1.9;list-style:none;position:relative}.card:before,.card:after{content:\"\";pointer-events:none;position:absolute;left:.5em}.card:before{border-left:1px solid #aaa;top:0;bottom:0}.card:last-child:before{height:.95em;bottom:auto}.card:after{border-top:1px solid #aaa;width:1em;top:.95em}.card-top{justify-content:space-between;align-items:baseline;gap:16px;display:flex}.cards-container .card-header{min-width:0;color:var(--folder-card-hover-font-color);overflow-wrap:anywhere;flex:auto;align-items:baseline;gap:.5em;font-weight:400;text-decoration:none;display:flex}.cards-container .card-header:hover .card-name{text-underline-offset:.2em;text-decoration:underline}.card-header>span{max-width:100%}.card-icon{text-align:center;flex:0 0 1.25em}.card-header svg{flex-shrink:0}.card-name{overflow-wrap:anywhere;min-width:0;margin:0}.card-time{white-space:nowrap;color:#777;flex-shrink:0;font-size:.8rem}.code-block-wrapper{position:relative}.code-block-wrapper>code{padding:1em;display:block}.copy-btn{cursor:pointer;opacity:0;background:#fff;border:1px solid #d8d8d8;border-radius:2px;justify-content:center;align-items:center;padding:5px;transition:opacity .15s,background-color .15s;display:inline-flex;position:absolute;top:6px;right:6px}.code-block-wrapper:hover>.copy-btn,.code-block-wrapper:focus-within>.copy-btn{opacity:1}.copy-btn:hover{background:#f5f5f5}.copy-btn:focus-visible{outline-offset:2px;opacity:1;outline:2px solid #8a1717}.copy-btn svg{fill:#333}@media (width<=480px){.card-top{flex-direction:column;align-items:flex-start;gap:0;padding-bottom:.5em}}@media print{.copy-btn{display:none}}@media (hover:none){.copy-btn{opacity:1}}"
