pub const css = ".mGzJhG-container{--font-color:#1a1a1a;--container-color:#fff;--card-color:#fff;--button-color:#eee;--idle-color:236, 224, 224;--complete-color:#e1ebe3;--failed-color:#f2dddd;box-sizing:border-box;background:var(--container-color);width:100%;min-height:100vh;color:var(--font-color);justify-content:center;align-items:center;padding:32px 16px;display:flex}.mGzJhG-file-card{box-sizing:border-box;background:var(--card-color);text-align:left;border-top:1px solid #d8d8d8;border-bottom:1px solid #d8d8d8;width:min(100%,32rem);padding:24px 0}.mGzJhG-file-name{overflow-wrap:anywhere;white-space:normal;margin:0 0 24px;font-size:clamp(1.25rem,4vw,1.75rem);line-height:1.4}.mGzJhG-download-btn{background:var(--button-color);color:#631919;width:100%;min-height:52px;font:inherit;font-family:var(--zFontSansSerif);cursor:pointer;border:0;border-radius:2px;justify-content:center;align-items:center;gap:12px;padding:12px 16px;display:flex;position:relative;overflow:hidden}.mGzJhG-download-btn:disabled{cursor:default}.mGzJhG-download-btn:focus-visible{outline-offset:4px;outline:2px solid #8a1717}.mGzJhG-download-btn .mGzJhG-btn-text{z-index:2;font-size:1rem;position:relative}.mGzJhG-download-btn svg{z-index:2;fill:currentColor;width:24px;height:24px;position:relative}.mGzJhG-progress-layer{z-index:1;background:rgb(var(--idle-color));height:100%;transition:width .2s,background-color .15s;position:absolute;top:0;left:0}.mGzJhG-download-btn:not(:disabled):hover .mGzJhG-progress-layer{background:rgba(var(--idle-color), .85)}.mGzJhG-failed{background:var(--failed-color)}.mGzJhG-complete{background:var(--complete-color)}@media (prefers-reduced-motion:reduce){.mGzJhG-progress-layer{transition:none}}@media print{.mGzJhG-container{min-height:0}.mGzJhG-download-btn{display:none}}"
